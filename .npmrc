# Required for Jest ESM support. Stryker configs duplicate this in testRunnerNodeArgs
# because Stryker spawns its own child processes that don't inherit .npmrc settings.
node-options=--experimental-vm-modules

# Link local workspace packages instead of downloading from the registry. npm
# workspaces auto-linked these (deps are declared as "*"); pnpm does not link "*"
# specifiers unless these are enabled. Keeps published package.json specs unchanged
# (no need to rewrite "*" deps to the workspace: protocol).
link-workspace-packages=true
prefer-workspace-packages=true

# pnpm: keep peer deps resolving like npm 7+ (also pnpm 9's default; made explicit).
auto-install-peers=true
# Strict by default — do NOT enable shamefully-hoist or node-linker=hoisted. If a
# package needs a dep it does not declare, declare it (see migration Task 11), don't
# hoist around it.
