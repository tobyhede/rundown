# Prettier manages Markdown only in this repo; Biome owns JS/TS/JSON/CSS.
# Generated, vendored, and fixture Markdown is not Prettier-managed.
#
# Runbooks are executable specs parsed by the Rundown grammar, NOT prose —
# Prettier would escape globs/operators (e.g. `*` -> `\*`) and corrupt them.
**/*.runbook.md
# Skills are functional LLM-facing instructions, content-pinned by tests —
# reflowing their prose breaks substring assertions (skills/*.test.ts).
packages/claude-code-plugin/skills/**
**/dist/**
**/coverage/**
packages/parser/fixtures/**
packages/cli/__tests__/fixtures/**
docs/superpowers/**
# Git-ignored SDD workflow scratch (task briefs/reports); never committed.
.superpowers/**
**/CHANGELOG.md
.worktrees/**
# Claude Code-managed worktrees (git-excluded via .git/info/exclude, which
# Prettier cannot read): other branches' checkouts — their Markdown is checked
# on those branches, not from this tree.
.claude/worktrees/**
# Local PR-comment scratch file (untracked working notes, not repo content).
prcomment.md
site/**
# Machine-parsed banner (scripts/check-xstate-doc-version.mjs greps a single line)
docs/internal/xstate-patterns.md
