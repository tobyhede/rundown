# Dockerfile.verify — Multi-stage Docker verification for Rundown
# Verifies CLI + plugin installation in a clean Linux container.
#
# Stages:
#   base  — shared foundation (node, git, sudo, testuser, claude-code)
#   local — install from packed tarballs (pre-publish verification)
#   npm   — install from npm registry at runtime (post-publish verification)
#   e2e   — extends local with test fixture and E2E entrypoints
#
# Build:
#   docker build -f scripts/Dockerfile.verify --target local -t rundown-verify:local .
#   docker build -f scripts/Dockerfile.verify --target npm   -t rundown-verify:npm .
#   docker build -f scripts/Dockerfile.verify --target e2e   -t rundown-e2e:latest .
#
# Prerequisites:
#   Run scripts/verify-install.sh (which cleans dist/*.tgz before packing)
#   to ensure exactly one tarball per package. Stale tarballs will cause
#   glob ambiguity in the COPY and npm install steps below.

# ── Base stage ───────────────────────────────────────────────────────────────

FROM node:24-slim AS base

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      sudo \
      git \
      curl \
      ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Claude Code blocks root — create non-root user
RUN useradd -m -s /bin/bash testuser && \
    echo "testuser ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Copy entrypoint
COPY --chmod=755 scripts/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

USER testuser
WORKDIR /home/testuser

# Install Claude Code via native installer (WORKDIR must be set to avoid OOM from / traversal)
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN curl -fsSL https://claude.ai/install.sh | bash
SHELL ["/bin/sh", "-c"]
ENV PATH="/home/testuser/.local/bin:${PATH}"

# Install Codex CLI for the interactive Codex E2E harness.
USER root
RUN npm install -g @openai/codex@0.137.0
USER testuser

# ── Local stage (pre-publish) ────────────────────────────────────────────────

FROM base AS local

# NOTE: verify-install.sh must run before docker build to remove stale tarballs
# Copy packed tarballs
USER root
COPY dist/rundown-org-parser-*.tgz /tmp/tarballs/
COPY dist/rundown-org-core-*.tgz /tmp/tarballs/
COPY dist/rundown-org-cli-*.tgz /tmp/tarballs/
COPY dist/rundown-org-claude-code-plugin-*.tgz /tmp/tarballs/
COPY dist/rundown-org-mcp-*.tgz /tmp/tarballs/

# Install packages globally from tarballs (dependencies declared in package.json)
RUN npm install -g \
    /tmp/tarballs/rundown-org-parser-*.tgz \
    /tmp/tarballs/rundown-org-core-*.tgz \
    /tmp/tarballs/rundown-org-cli-*.tgz \
    /tmp/tarballs/rundown-org-claude-code-plugin-*.tgz \
    /tmp/tarballs/rundown-org-mcp-*.tgz && \
    rm -rf /tmp/tarballs

USER testuser

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["local"]

# ── npm stage (post-publish) ─────────────────────────────────────────────────

FROM base AS npm

# npm packages are installed at runtime via entrypoint
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["npm"]

# ── E2E stage (plugin workflow) ─────────────────────────────────────────────

FROM local AS e2e

USER root
COPY --chmod=755 scripts/e2e-entrypoint.sh /usr/local/bin/e2e-entrypoint.sh
COPY --chmod=755 scripts/e2e-shell-entrypoint.sh /usr/local/bin/e2e-shell-entrypoint.sh
COPY --chmod=755 scripts/e2e-codex-shell-entrypoint.sh /usr/local/bin/e2e-codex-shell-entrypoint.sh

# Rundown-aware Codex guidance. The Codex entrypoint copies this into the
# session workspace as AGENTS.md, which Codex reads on startup. This is the
# Codex equivalent of the Claude entrypoint's --plugin-dir wiring.
COPY --chmod=644 scripts/e2e-codex-agents.md /usr/local/share/rundown/codex-agents.md

# Copy test app fixture
COPY --chown=testuser:testuser tests/e2e/fixtures/test-app /home/testuser/fixture

USER testuser

ENTRYPOINT ["/usr/local/bin/e2e-entrypoint.sh"]
