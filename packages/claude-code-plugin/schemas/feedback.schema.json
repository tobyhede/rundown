{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rundown.org/schemas/feedback.schema.json",
  "title": "Feedback",
  "description": "Agent execution feedback for runbook and skill quality assessment.",
  "type": "object",
  "$defs": {
    "StepFeedback": {
      "type": "object",
      "required": ["step", "name", "friction"],
      "properties": {
        "step": {
          "type": "integer",
          "minimum": 1,
          "description": "Step number in the runbook"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Step name as it appears in the runbook"
        },
        "friction": {
          "type": "string",
          "enum": ["none", "low", "medium", "high"],
          "description": "How much friction this step caused"
        },
        "notes": {
          "type": "string",
          "description": "What caused friction or what worked well"
        }
      },
      "additionalProperties": false
    },
    "Rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Rating from 1 (poor) to 5 (excellent)"
    }
  },
  "required": ["meta", "runbook", "skill", "steps", "overall"],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri",
      "const": "https://rundown.org/schemas/feedback.schema.json",
      "description": "Schema URI for editor autocomplete and rdx validation dispatch."
    },
    "meta": {
      "type": "object",
      "required": ["version"],
      "properties": {
        "version": {
          "const": "1.0.0"
        }
      },
      "additionalProperties": false
    },
    "runbook": {
      "type": "string",
      "minLength": 1,
      "description": "Runbook name or identifier"
    },
    "skill": {
      "type": "string",
      "minLength": 1,
      "description": "Skill name that orchestrated the runbook"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/StepFeedback" }
    },
    "overall": {
      "type": "object",
      "required": ["clarity", "completeness", "accuracy"],
      "properties": {
        "clarity": {
          "$ref": "#/$defs/Rating",
          "description": "Were instructions clear and unambiguous?"
        },
        "completeness": {
          "$ref": "#/$defs/Rating",
          "description": "Were all necessary instructions provided?"
        },
        "accuracy": {
          "$ref": "#/$defs/Rating",
          "description": "Did following instructions produce correct results?"
        }
      },
      "additionalProperties": false
    },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Specific improvements to the skill or runbook"
    },
    "improvised": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Actions taken that were not covered by instructions"
    }
  },
  "additionalProperties": false
}
