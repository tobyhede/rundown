# Dockerfile.test - Container for cross-platform testing
# Build: docker build -f Dockerfile.test -t claude-code-plugin-test .
# Run: docker run --rm claude-code-plugin-test

FROM node:20-slim

# Set working directory
WORKDIR /app

# Install bash for smoke tests
RUN apt-get update && apt-get install -y bash && rm -rf /var/lib/apt/lists/*

# Copy package files first for better caching
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy source and test files
COPY tsconfig.json jest.config.js jest.setup.ts ./
COPY src/ ./src/
COPY __tests__/ ./__tests__/
COPY scripts/ ./scripts/
COPY rundown-plugin.json ./

# Build the plugin
RUN npm run build

# Set environment for tests
ENV NODE_ENV=test
ENV RUNDOWN_PLUGIN_LOG=0

# Run tests by default
CMD ["npm", "run", "test:smoke"]
