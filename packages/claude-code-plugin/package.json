{
  "name": "@rundown-org/claude-code-plugin",
  "version": "1.0.0",
  "description": "Claude Code plugin for runbook orchestration and workflow execution",
  "type": "module",
  "bin": {
    "rdpath": "dist/rdpath.js",
    "rdx": "dist/rdx.js"
  },
  "main": "dist/cli.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./cli": {
      "import": "./dist/cli.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    ".claude-plugin",
    "commands",
    "hooks",
    "runbooks",
    "rundown-plugin.json",
    "scripts",
    "skills",
    "templates",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/validate-runbooks.js",
    "check:types": "tsc --noEmit -p tsconfig.test.json",
    "validate:runbooks": "node scripts/validate-runbooks.js",
    "test": "jest",
    "test:unit": "jest --maxWorkers=2 --testPathIgnorePatterns='(integration|\\.properties\\.test\\.ts$|perf/)'",
    "test:integration": "jest --maxWorkers=2 --testPathPatterns='(integration/|integration\\.test\\.ts$)'",
    "test:property": "jest --maxWorkers=2 --testPathPatterns='\\.properties\\.test\\.ts$'",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:perf": "jest --maxWorkers=2 --testPathPatterns=perf",
    "test:smoke": "bash scripts/smoke-test.sh",
    "test:mutate": "stryker run",
    "clean": "rm -rf dist",
    "lint": "eslint src/**/*.ts __tests__/**/*.ts"
  },
  "keywords": [
    "rundown",
    "runbook",
    "claude-code",
    "plugin",
    "workflow"
  ],
  "author": "Toby Hede",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rundown-org/rundown.git",
    "directory": "packages/claude-code-plugin"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@rundown-org/core": "*",
    "@rundown-org/cli": "*",
    "commander": "^14.0.2",
    "js-yaml": "^4.1.1",
    "mdast-util-from-markdown": "^2.0.3",
    "minimatch": "^10.2.5",
    "unist-util-visit": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.8.0",
    "fast-check": "^4.8.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.3"
  }
}
