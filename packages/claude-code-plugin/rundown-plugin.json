{
  "gates": {
    "on-command-start": {},
    "on-skill-start": {},
    "on-delegation-dispatch": {},
    "on-delegated-bash-guard": {},
    "on-subagent-stop": {}
  },
  "hooks": {
    "PreToolUse": {
      "enabled_tools": ["Agent", "Task", "Bash"],
      "gates": ["on-delegation-dispatch", "on-delegated-bash-guard"]
    },
    "SubagentStop": {
      "gates": ["on-subagent-stop"]
    },
    "SlashCommandStart": {
      "gates": ["on-command-start"]
    },
    "SkillStart": {
      "gates": ["on-skill-start"]
    }
  }
}
