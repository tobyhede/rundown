{
  "gates": {
    "check": {
      "command": "npm run lint",
      "on_pass": "CONTINUE",
      "on_fail": "BLOCK"
    },
    "on-command-start": {},
    "on-skill-start": {},
    "on-delegation-dispatch": {},
    "on-subagent-stop": {}
  },
  "hooks": {
    "PreToolUse": {
      "enabled_tools": ["Agent", "Task"],
      "gates": ["on-delegation-dispatch"]
    },
    "SubagentStop": {
      "gates": ["on-subagent-stop"]
    },
    "PostToolUse": {
      "enabled_tools": ["Agent", "Edit", "Write", "Step", "Task"],
      "gates": ["check"]
    },
    "SlashCommandStart": {
      "gates": ["on-command-start"]
    },
    "SkillStart": {
      "gates": ["on-skill-start"]
    }
  }
}
