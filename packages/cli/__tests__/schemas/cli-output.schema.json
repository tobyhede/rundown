{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rundown.org/schemas/cli-output.schema.json",
  "title": "CLI JSON Output Schema",
  "description": "Standardized JSON output format for Rundown CLI commands",

  "definitions": {
    "errorCode": {
      "type": "string",
      "enum": [
        "NO_ACTIVE_RUNBOOK",
        "RUNBOOK_NOT_FOUND",
        "STEP_NOT_FOUND",
        "INVALID_SYNTAX",
        "VALIDATION_ERROR",
        "NO_STASHED_RUNBOOK",
        "AGENT_BINDING_ERROR",
        "SCENARIO_NOT_FOUND",
        "FILE_ERROR",
        "UNKNOWN_ERROR"
      ],
      "description": "Machine-readable error codes"
    },

    "position": {
      "type": "object",
      "properties": {
        "current": {
          "type": "string",
          "description": "Current step identifier"
        },
        "total": {
          "oneOf": [
            { "type": "number" },
            { "type": "string" }
          ],
          "description": "Total number of steps (number or '{N}' for dynamic)"
        },
        "substep": {
          "type": "string",
          "description": "Current substep identifier"
        }
      },
      "required": ["current", "total"],
      "additionalProperties": false
    },

    "runbookContext": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "description": "Runbook filename"
        },
        "state": {
          "type": "string",
          "description": "State file path"
        },
        "prompted": {
          "type": "boolean",
          "description": "Whether runbook is in prompted mode"
        }
      },
      "required": ["file", "state"],
      "additionalProperties": false
    },

    "errorDetails": {
      "type": "object",
      "properties": {
        "requested": {
          "type": "string",
          "description": "Value that was requested but invalid"
        },
        "available": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Available valid options"
        },
        "suggestion": {
          "type": "string",
          "description": "Suggested command to run"
        },
        "path": {
          "type": "string",
          "description": "File path related to the error"
        },
        "searchedLocations": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Locations that were searched"
        },
        "line": {
          "type": "number",
          "description": "Line number where error occurred"
        }
      },
      "additionalProperties": true
    },

    "errorResponse": {
      "type": "object",
      "properties": {
        "result": {
          "type": "boolean",
          "const": false
        },
        "error": {
          "type": "string",
          "description": "Human-readable error message"
        },
        "code": {
          "$ref": "#/definitions/errorCode"
        },
        "details": {
          "$ref": "#/definitions/errorDetails"
        }
      },
      "required": ["result", "error"],
      "additionalProperties": true
    },

    "actionResponse": {
      "type": "object",
      "properties": {
        "result": {
          "type": "boolean"
        },
        "action": {
          "type": "string",
          "description": "Action performed (e.g., CONTINUE, GOTO 3)"
        },
        "actionResult": {
          "type": "string",
          "enum": ["PASS", "FAIL"],
          "description": "Result of action evaluation"
        },
        "command": {
          "type": "string",
          "description": "Command that was executed"
        },
        "from": {
          "$ref": "#/definitions/position"
        },
        "to": {
          "$ref": "#/definitions/position"
        },
        "complete": {
          "type": "boolean",
          "description": "Whether runbook completed"
        },
        "stopped": {
          "type": "boolean",
          "description": "Whether runbook stopped"
        },
        "runbook": {
          "$ref": "#/definitions/runbookContext"
        },
        "file": {
          "type": "string",
          "description": "Runbook file (legacy format)"
        },
        "state": {
          "type": "string",
          "description": "State file (legacy format)"
        },
        "prompted": {
          "type": "boolean",
          "description": "Prompted state (legacy format)"
        },
        "message": {
          "type": "string",
          "description": "Additional message"
        },
        "position": {
          "$ref": "#/definitions/position"
        }
      },
      "required": ["action"],
      "additionalProperties": true
    },

    "statusResponse": {
      "type": "object",
      "properties": {
        "active": {
          "type": "boolean",
          "description": "Whether a runbook is active"
        },
        "stashed": {
          "type": "boolean",
          "description": "Whether a runbook is stashed"
        },
        "runbook": {
          "$ref": "#/definitions/runbookContext"
        },
        "position": {
          "$ref": "#/definitions/position"
        },
        "step": {
          "$ref": "#/definitions/position"
        },
        "currentStep": {
          "type": "object",
          "properties": {
            "description": { "type": "string" },
            "command": { "type": "string" }
          }
        },
        "lastAction": {
          "type": "object",
          "properties": {
            "action": { "type": "string" },
            "result": { "type": "string" }
          }
        }
      },
      "required": ["active", "stashed"],
      "additionalProperties": true
    },

    "activeRunbookEntry": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique runbook instance ID"
        },
        "runbook": {
          "type": "string",
          "description": "Runbook filename"
        },
        "step": {
          "type": "string",
          "description": "Current step display"
        },
        "status": {
          "type": "string",
          "description": "Runbook status"
        }
      },
      "required": ["id", "runbook", "step"],
      "additionalProperties": false
    },

    "availableRunbookEntry": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Runbook name"
        },
        "description": {
          "type": "string",
          "description": "Runbook description"
        },
        "path": {
          "type": "string",
          "description": "Path to runbook file"
        }
      },
      "required": ["name", "path"],
      "additionalProperties": false
    },

    "validationError": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string",
          "description": "Error message"
        },
        "line": {
          "type": "number",
          "description": "Line number"
        }
      },
      "required": ["message"],
      "additionalProperties": false
    },

    "checkResponse": {
      "type": "object",
      "properties": {
        "valid": {
          "type": "boolean",
          "description": "Whether the runbook is valid"
        },
        "errors": {
          "type": "array",
          "items": { "$ref": "#/definitions/validationError" },
          "description": "List of validation errors"
        },
        "stats": {
          "type": "object",
          "properties": {
            "steps": { "type": "number" },
            "substeps": { "type": "number" }
          },
          "required": ["steps", "substeps"],
          "additionalProperties": false
        }
      },
      "required": ["valid", "errors"],
      "additionalProperties": false
    },

    "scenarioEntry": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Scenario name"
        },
        "expected": {
          "type": "string",
          "description": "Expected result"
        },
        "description": {
          "type": "string",
          "description": "Scenario description"
        },
        "tags": {
          "type": "string",
          "description": "Comma-separated tags"
        }
      },
      "required": ["name", "expected"],
      "additionalProperties": false
    },

    "scenarioDetail": {
      "allOf": [
        { "$ref": "#/definitions/scenarioEntry" },
        {
          "type": "object",
          "properties": {
            "commands": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Commands to execute"
            }
          }
        }
      ]
    },

    "scenarioRunResponse": {
      "type": "object",
      "properties": {
        "result": {
          "type": "boolean",
          "description": "Whether scenario passed"
        },
        "scenario": {
          "type": "string",
          "description": "Scenario name"
        },
        "expected": {
          "type": "string",
          "description": "Expected outcome"
        },
        "actual": {
          "type": "string",
          "description": "Actual outcome"
        },
        "message": {
          "type": "string",
          "description": "Detailed message"
        }
      },
      "required": ["result", "scenario", "expected", "actual"],
      "additionalProperties": false
    },

    "echoResponse": {
      "type": "object",
      "properties": {
        "content": {
          "type": "string",
          "description": "Echoed content"
        },
        "result": {
          "type": "string",
          "enum": ["PASS", "FAIL"],
          "description": "Result code"
        }
      },
      "required": ["content"],
      "additionalProperties": false
    },

    "pruneEntry": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "State file ID"
        },
        "runbook": {
          "type": "string",
          "description": "Associated runbook file"
        },
        "reason": {
          "type": "string",
          "description": "Reason for pruning"
        }
      },
      "required": ["id", "runbook", "reason"],
      "additionalProperties": false
    },

    "stashResponse": {
      "type": "object",
      "properties": {
        "result": {
          "type": "boolean",
          "const": true
        },
        "action": {
          "type": "string",
          "const": "stash"
        },
        "stashedId": {
          "type": "string",
          "description": "ID of stashed runbook"
        },
        "runbook": {
          "$ref": "#/definitions/runbookContext"
        },
        "file": {
          "type": "string"
        },
        "state": {
          "type": "string"
        }
      },
      "required": ["result", "action"],
      "additionalProperties": true
    },

    "popResponse": {
      "type": "object",
      "properties": {
        "result": {
          "type": "boolean",
          "const": true
        },
        "action": {
          "type": "string",
          "const": "pop"
        },
        "restoredId": {
          "type": "string",
          "description": "ID of restored runbook"
        },
        "runbook": {
          "$ref": "#/definitions/runbookContext"
        },
        "file": {
          "type": "string"
        },
        "state": {
          "type": "string"
        }
      },
      "required": ["result", "action"],
      "additionalProperties": true
    }
  },

  "oneOf": [
    { "$ref": "#/definitions/errorResponse" },
    { "$ref": "#/definitions/actionResponse" },
    { "$ref": "#/definitions/statusResponse" },
    { "$ref": "#/definitions/checkResponse" },
    { "$ref": "#/definitions/scenarioRunResponse" },
    { "$ref": "#/definitions/stashResponse" },
    { "$ref": "#/definitions/popResponse" },
    { "$ref": "#/definitions/echoResponse" },
    {
      "type": "array",
      "description": "List responses (ls, scenario ls, prune)",
      "items": {
        "oneOf": [
          { "$ref": "#/definitions/activeRunbookEntry" },
          { "$ref": "#/definitions/availableRunbookEntry" },
          { "$ref": "#/definitions/scenarioEntry" },
          { "$ref": "#/definitions/pruneEntry" }
        ]
      }
    }
  ]
}
