{
  "name": "@rundown-org/cli",
  "version": "1.0.0",
  "description": "Runbook orchestration CLI",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "rundown": "dist/cli.js",
    "rd": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js && node scripts/copy-runbooks.js",
    "check:types": "tsc --noEmit -p tsconfig.test.json",
    "test": "jest",
    "test:unit": "jest --maxWorkers=2 --testPathIgnorePatterns='integration'",
    "test:integration": "jest --maxWorkers=2 --testPathPatterns='integration'",
    "test:coverage": "jest --coverage",
    "test:mutate": "stryker run",
    "test:mutate:dry": "stryker run --dryRunOnly",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "rundown",
    "runbook",
    "cli",
    "markdown"
  ],
  "author": "Toby Hede",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobyhede/rundown.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@rundown-org/core": "*",
    "@rundown-org/parser": "*",
    "commander": "^15.0.0",
    "handlebars": "^4.7.9",
    "js-yaml": "^4.2.0",
    "minimatch": "^10.2.5",
    "shell-quote": "^1.8.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/jest-runner": "^9.6.1",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.0.0",
    "@types/shell-quote": "^1.7.5",
    "fast-check": "^4.8.0",
    "jest": "^30.4.2",
    "jest-environment-node": "^30.4.1",
    "jest-mock": "^30.4.1",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3"
  }
}
