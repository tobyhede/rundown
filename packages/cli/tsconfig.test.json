{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "isolatedModules": true,
    "types": ["node", "jest"]
  },
  "include": ["src/**/*", "__tests__/**/*", "jest.setup.ts"],
  // Base tsconfig excludes **/*.test.ts; redeclare exclude without that pattern so CLI tests stay type-checked.
  "exclude": ["node_modules", "dist"]
}
