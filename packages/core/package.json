{
  "name": "@rundown-org/core",
  "version": "1.0.0",
  "description": "Core runbook state management and execution for Rundown",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./session-reader": {
      "import": "./dist/runbook/session-reader.js",
      "types": "./dist/runbook/session-reader.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "check:types": "tsc --noEmit -p tsconfig.test.json",
    "test": "jest",
    "test:unit": "jest --maxWorkers=2",
    "test:coverage": "jest --coverage",
    "test:property": "jest --maxWorkers=2 --testPathPatterns='\\.properties\\.test\\.ts$'",
    "test:mutate": "stryker run",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "rundown",
    "runbook",
    "state-machine",
    "xstate"
  ],
  "author": "Toby Hede",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobyhede/rundown.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.3",
    "@rundown-org/parser": "*",
    "js-yaml": "^4.1.1",
    "lilconfig": "^3.1.3",
    "picomatch": "^4.0.4",
    "xstate": "^5.31.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.7.0",
    "@types/picomatch": "^4.0.3",
    "fast-check": "^4.8.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.3"
  }
}
