{
  "name": "@rundown-org/parser",
  "version": "1.0.0",
  "description": "Markdown runbook parser for Rundown",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "check:types": "tsc --noEmit -p tsconfig.test.json",
    "test": "jest",
    "test:unit": "jest --maxWorkers=2",
    "test:coverage": "jest --coverage",
    "test:mutate": "stryker run",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "rundown",
    "runbook",
    "parser",
    "markdown"
  ],
  "author": "Toby Hede",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobyhede/rundown.git",
    "directory": "packages/parser"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "mdast-util-from-markdown": "^2.0.3",
    "unist-util-visit": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.8.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.3"
  }
}
