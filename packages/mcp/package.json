{
  "name": "@rundown-org/mcp",
  "version": "1.0.0",
  "description": "MCP server for Rundown runbook execution",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "rundown-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "check:types": "tsc --noEmit -p tsconfig.test.json",
    "test": "jest",
    "test:unit": "jest --maxWorkers=2",
    "test:coverage": "jest --coverage",
    "analyze:complexity": "fta src --score-cap 54"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@rundown-org/core": "*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "fta-cli": "3.0.1",
    "jest": "^30.5.2",
    "jest-mock": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "^6.0.3"
  }
}
