{
  "name": "@rundown-org/mcp",
  "version": "1.0.0",
  "description": "MCP server for Rundown runbook execution",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "rundown-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "check:types": "tsc --noEmit -p tsconfig.test.json",
    "test": "jest",
    "test:unit": "jest --maxWorkers=2",
    "test:coverage": "jest --coverage",
    "analyze:complexity": "fta src --score-cap 63"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@rundown-org/core": "*",
    "zod": "^4.4.3"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": {
      "hono": "^4.12.21",
      "@hono/node-server": "^1.19.13",
      "express-rate-limit": "^8.5.2"
    },
    "@hono/node-server": {
      "hono": "^4.12.21"
    },
    "express-rate-limit": {
      "ip-address": "^10.1.1"
    }
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.1",
    "fta-cli": "3.0.0",
    "jest": "^30.4.2",
    "jest-mock": "^30.4.1",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3"
  }
}
