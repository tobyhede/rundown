{
  "version": "0.2",
  "language": "en",
  "dictionaryDefinitions": [
    {
      "name": "rundown",
      "path": "./cspell-dictionary.txt",
      "addWords": true
    }
  ],
  "dictionaries": ["rundown"],
  "files": [
    "packages/*/src/**/*.ts",
    "packages/*/__tests__/**/*.ts",
    "docs/**/*.md",
    "runbooks/**/*.md",
    "scripts/**",
    "*.md",
    ".github/**/*.md",
    "*.ts",
    "*.js",
    "LICENSE"
  ],
  "ignorePaths": [
    "node_modules",
    "dist",
    "coverage",
    "site",
    "/.worktree",
    "/.worktrees",
    "/.claude/worktrees",
    "/prcomment.md",
    "docs/superpowers",
    "*.snap",
    "package-lock.json",
    "*.json",
    "*.yaml",
    "*.yml",
    "patches"
  ],
  "ignoreRegExpList": [
    "fencedCode",
    "inlineCode",
    "/import\\s+.*from\\s+['\"].*['\"]/g",
    "/require\\(['\"](.*)['\"]\\)/g"
  ],
  "useGitignore": true,
  "gitignoreRoot": "."
}
