# Nested rundown/claude runtime state (e.g. inside test fixtures).
# The patterns above are anchored to the repo root because they contain
# slashes; the patterns below match at any depth via the leading `**/`.
**/.rundown/work/
**/.rundown/runs/
**/.rundown/session.json
**/.rundown/locks/
.work/
.worktree/
.worktrees/
.claude/settings.local.json
.claude/session/
.claude/rundown/
**/.claude/settings.local.json
**/.claude/session/
**/.claude/rundown/
.claude-docker/
.codex-docker/
# Agent scratch output (SDD task reports etc.) — never part of the repo.
.superpowers/
# Local pnpm content-addressable store.
.pnpm-store/
# Machine-local Serena overrides (project.yml itself is tracked).
.serena/project.local.yml
logs/
# Captured output from the end-to-end-test runbook (FeedbackPath); not a fixture.
**/end-to-end-test-feedback.json
docs/plans/
docs/internal/plans/
graphify-out/

# WebContainer snapshot (build artifact — rebuilt by CI and locally via npm run build:snapshot -w site)
site/public/rundown-snapshot.bin

# Stryker mutation testing
reports/
.stryker-tmp*/
packages/*/reports/
packages/*/.stryker-tmp/

# TypeScript incremental build
*.tsbuildinfo
