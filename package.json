{
  "name": "rundown-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "site"
  ],
  "scripts": {
    "build": "npm run build -w packages/parser && npm run build -w packages/core && npm run build -w packages/cli && npm run build -w packages/claude-code-plugin && npm run build -w packages/mcp",
    "build:site": "npm run build -w site",
    "build:all": "npm run build && npm run build -w site",
    "test": "npm run test:unit",
    "test:unit": "run-p test:unit:*",
    "test:unit:parser": "npm run test:unit -w packages/parser",
    "test:unit:core": "npm run test:unit -w packages/core",
    "test:unit:cli": "npm run test:unit -w packages/cli",
    "test:unit:plugin": "npm run test:unit -w packages/claude-code-plugin",
    "test:unit:mcp": "npm run test:unit -w packages/mcp",
    "test:integration": "run-p test:integration:*",
    "test:integration:cli": "npm run test:integration -w packages/cli",
    "test:integration:plugin": "npm run test:integration -w packages/claude-code-plugin",
    "test:property": "npm run test:property -w packages/claude-code-plugin -w packages/core",
    "test:perf": "npm run test:perf -w packages/claude-code-plugin",
    "test:all": "run-s test:unit test:integration test:property test:perf",
    "test:mutate": "run-s test:mutate:parser test:mutate:core test:mutate:cli test:mutate:plugin",
    "test:mutate:parser": "npm run test:mutate -w packages/parser",
    "test:mutate:core": "npm run test:mutate -w packages/core",
    "test:mutate:cli": "npm run test:mutate -w packages/cli --",
    "test:mutate:cli:dry": "npm run test:mutate:dry -w packages/cli",
    "test:mutate:plugin": "npm run test:mutate -w packages/claude-code-plugin",
    "test:pw": "npm run test -w site",
    "test:coverage": "run-p test:coverage:*",
    "test:coverage:parser": "npm run test:coverage -w packages/parser",
    "test:coverage:core": "npm run test:coverage -w packages/core",
    "test:coverage:cli": "npm run test:coverage -w packages/cli",
    "test:coverage:plugin": "npm run test:coverage -w packages/claude-code-plugin",
    "test:coverage:mcp": "npm run test:coverage -w packages/mcp",
    "test:scenarios:raw": "node scripts/test-scenarios.mjs",
    "test:scenario-suites:raw": "node scripts/test-scenario-suites.mjs",
    "test:scenarios": "npm run build && npm run test:scenarios:raw",
    "test:scenario-suites": "npm run build && npm run test:scenario-suites:raw",
    "test:scenarios:all": "npm run build && run-s test:scenarios:raw test:scenario-suites:raw",
    "format": "biome format --write .",
    "check:format": "biome check --formatter-enabled=true --linter-enabled=false .",
    "check:spell": "cspell --no-progress --no-must-find-files .",
    "check:lint:fast": "biome lint .",
    "check:lint:typed": "eslint .",
    "check:types": "run-p check:types:core check:types:parser check:types:plugin check:types:cli check:types:mcp",
    "check:types:core": "npm run check:types -w packages/core",
    "check:types:parser": "npm run check:types -w packages/parser",
    "check:types:plugin": "npm run check:types -w packages/claude-code-plugin",
    "check:types:cli": "npm run check:types -w packages/cli",
    "check:types:mcp": "npm run check:types -w packages/mcp",
    "fix:lint:fast": "biome lint --write .",
    "fix:lint:typed": "eslint . --fix",
    "fix:lint": "npm run fix:lint:fast && npm run fix:lint:typed",
    "check:complexity": "run-p check:complexity:*",
    "check:complexity:biome": "biome lint --only=complexity/noExcessiveCognitiveComplexity .",
    "check:complexity:eslint": "eslint --config eslint.complexity.config.js .",
    "lint": "npm run check:lint:fast && npm run check:lint:typed",
    "verify": "run-s check:format check:spell check:lint:fast check:lint:typed build check:types check:docs:cli-help check:docs:xstate-version test",
    "cli": "node packages/cli/dist/cli.js",
    "docs:cli-help": "npm run build -w packages/parser -w packages/core -w packages/cli && node packages/cli/dist/scripts/gen-cli-help.js",
    "check:docs:cli-help": "npm run build -w packages/parser -w packages/core -w packages/cli && node packages/cli/dist/scripts/gen-cli-help.js --check",
    "check:docs:xstate-version": "node scripts/check-xstate-doc-version.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "prepare": "husky || true",
    "verify:claude": "./scripts/verify-install.sh local",
    "verify:claude:npm": "./scripts/verify-install.sh npm",
    "test:e2e": "./scripts/run-e2e.sh",
    "test:e2e:build": "./scripts/build-e2e.sh",
    "test:e2e:shell": "./scripts/e2e-shell.sh"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css}": [
      "biome format --write --no-errors-on-unmatched",
      "biome lint --no-errors-on-unmatched"
    ]
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "//overrides": "Security overrides for transitive deps — scoped by consumer, remove when upstream updates. lodash/flatted/devalue: multiple consumers (blanket). devalue: sparse-array DoS (GHSA-77vg-94rm-hx3p, patched 5.8.1) via astro + @astrojs/react. @modelcontextprotocol/sdk: hono auth bypass/file access/injection, node-server encoded slash bypass, rate-limit IPv6 bypass. astro: svgo Billion Laughs DoS. test-exclude: minimatch ReDoS (glob 10.x ships minimatch 9.x which is safe).",
  "overrides": {
    "lodash": "^4.17.23",
    "flatted": "^3.4.0",
    "devalue": "^5.8.1",
    "@modelcontextprotocol/sdk": {
      "hono": "^4.12.7",
      "@hono/node-server": "^1.19.10",
      "express-rate-limit": "^8.2.2"
    },
    "astro": {
      "svgo": "^4.0.1"
    },
    "test-exclude": {
      "minimatch": "^3.1.3"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "glob": "^13.0.6",
    "@changesets/cli": "^2.31.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/jest-runner": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "cspell": "^10.0.1",
    "eslint": "^10.4.1",
    "eslint-plugin-jsdoc": "^63.0.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "npm-run-all2": "^9.0.1",
    "typescript-eslint": "^8.60.1"
  }
}
